{
  "name": "@soundwala/spur",
  "version": "0.2.1",
  "description": "SPUR — Skill & Plugin Update Radar. Scans every Claude Code skill/plugin install method and reports which are out of date vs their source repos. Local-only; zero runtime dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soundwala/spur.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "spur": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
